MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DATABASE=charging_demo

# Examples:
# Local process on your machine: mongodb://localhost:27017/?directConnection=true
# Docker local demo (handled automatically by `make build`): mongodb://mongodb:27017/?replicaSet=rs0&directConnection=true
# Atlas: mongodb+srv://...

BACKEND_URL=http://localhost:4000
BACKEND_CORS_ORIGIN=http://localhost:3000
SIMULATOR_URL=http://localhost:8000

SESSION_TELEMETRY_INTERVAL_SECONDS=2
CHANGE_STREAM_RETRY_SECONDS=2

# AI assistants (optional). The app does NOT ship with an LLM: bring your own provider.
# Without these settings everything else runs and the assistants report they are not configured.
# The provider must expose an Anthropic Messages API (.../v1/messages) or an
# OpenAI-compatible Chat Completions API (.../v1/chat/completions) endpoint.
#
# Anthropic format: base URL WITHOUT /v1, e.g. https://api.anthropic.com or your gateway's /anthropic route
# OpenAI format:    base URL WITH /v1,    e.g. https://api.openai.com/v1 or your gateway's /openai/v1 route
AI_GATEWAY_BASE_URL=https://ai-gateway.corp.mongodb.com/anthropic
AI_GATEWAY_MODEL=claude-haiku-4-5
AI_GATEWAY_API_KEY_PRIM=<your-llm-api-key>
# Optional: second key, tried if the first is rejected (401/403/429)
# AI_GATEWAY_API_KEY_SEC=<your-fallback-llm-api-key>
# Optional: "anthropic" or "openai". Inferred from the base URL when unset
# (a URL containing /anthropic means anthropic, anything else means openai).
# AI_GATEWAY_PROVIDER=anthropic
# Optional: some models reject non-default sampling values, so this is unset by default.
# AI_GATEWAY_TEMPERATURE=
# AI_GATEWAY_MAX_TOKENS=4096

NEXT_PUBLIC_CARTO_API_KEY=<your-carto-api-key>
